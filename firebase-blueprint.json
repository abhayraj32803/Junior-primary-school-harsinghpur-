{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile credentials with role-based access control.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "description": "Unique Firebase Authentication UID" },
        "username": { "type": "string", "maxLength": 80, "description": "Institutional username or login ID" },
        "name": { "type": "string", "maxLength": 150, "description": "Full name of the user" },
        "email": { "type": "string", "maxLength": 150, "description": "User email address" },
        "phone": { "type": "string", "maxLength": 25, "description": "Contact phone number" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"], "description": "Security access role" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending", "suspended", "disabled"], "description": "Account approval status" },
        "linkedEntityId": { "type": "string", "maxLength": 100, "description": "Linked studentId or teacherId" },
        "admissionNumber": { "type": "string", "maxLength": 50, "description": "Official school admission number" },
        "employeeId": { "type": "string", "maxLength": 50, "description": "Teacher employee identification number" },
        "classNumber": { "type": "number", "description": "Assigned class grade level (1-8)" },
        "sectionName": { "type": "string", "maxLength": 10, "description": "Assigned section (A, B, C)" },
        "isApproved": { "type": "boolean", "description": "Whether account is verified" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Official student admission and academic record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Document unique identifier" },
        "studentId": { "type": "string", "maxLength": 50, "description": "Institutional Student Code" },
        "userId": { "type": "string", "maxLength": 128, "description": "Linked user authentication UID" },
        "uid": { "type": "string", "maxLength": 128, "description": "Linked Firebase Auth UID" },
        "admissionNumber": { "type": "string", "maxLength": 50, "description": "Official Admission Number" },
        "name": { "type": "string", "maxLength": 150, "description": "Student full name" },
        "dateOfBirth": { "type": "string", "maxLength": 20, "description": "DOB in YYYY-MM-DD" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"], "description": "Gender identity" },
        "classId": { "type": "string", "maxLength": 50, "description": "Class identifier" },
        "classNumber": { "type": "number", "description": "Grade level (1 to 8)" },
        "sectionId": { "type": "string", "maxLength": 50, "description": "Section identifier" },
        "sectionName": { "type": "string", "maxLength": 10, "description": "Section designation" },
        "rollNumber": { "type": "string", "maxLength": 20, "description": "Class roll number" },
        "fatherName": { "type": "string", "maxLength": 150, "description": "Father name" },
        "motherName": { "type": "string", "maxLength": 150, "description": "Mother name" },
        "mobile": { "type": "string", "maxLength": 25, "description": "Emergency / parent contact number" },
        "address": { "type": "string", "maxLength": 300, "description": "Residential address" },
        "status": { "type": "string", "enum": ["active", "inactive", "transferred"], "description": "Enrollment status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "admissionNumber", "name", "classNumber", "sectionName", "rollNumber", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty member record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "designation": { "type": "string", "maxLength": 100 },
        "qualification": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "on_leave", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "employeeId", "name", "email", "designation", "status"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Academic class definition (Class 1 to Class 8).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "number" },
        "name": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classNumber", "name"]
    },
    "Section": {
      "title": "Section",
      "description": "Class section allocation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "classNumber", "sectionName"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curriculum subject mapped to a class.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "classNumber": { "type": "number" }
      },
      "required": ["id", "name", "classNumber"]
    },
    "TeacherAssignment": {
      "title": "TeacherAssignment",
      "description": "Mapping of teachers to classes, sections, and subjects.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 150 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 20 },
        "subjectName": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "teacherId"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily student attendance tracking record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "rollNumber": { "type": "string", "maxLength": 20 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 50 },
        "classNumber": { "type": "number" },
        "sectionId": { "type": "string", "maxLength": 50 },
        "sectionName": { "type": "string", "maxLength": 10 },
        "date": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["present", "absent", "late", "half_day"] },
        "remarks": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "classNumber", "sectionName", "date", "status"]
    },
    "Examination": {
      "title": "Examination",
      "description": "Academic examination schedule and metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "academicYear": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Mark": {
      "title": "Mark",
      "description": "Academic examination score entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "examId": { "type": "string", "maxLength": 128 },
        "examName": { "type": "string", "maxLength": 150 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 10 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "marksObtained": { "type": "number" },
        "maximumMarks": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "percentage": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "examId", "subjectId", "marksObtained", "maximumMarks"]
    },
    "Homework": {
      "title": "Homework",
      "description": "Class assignment created by faculty.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 10 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] }
      },
      "required": ["id", "teacherId", "classNumber", "title", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student homework submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "homeworkId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "graded"] },
        "marks": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "homeworkId", "studentId", "status"]
    },
    "TimetableItem": {
      "title": "TimetableItem",
      "description": "Class schedule period item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 20 },
        "day": { "type": "string", "maxLength": 20 },
        "periodNumber": { "type": "number" },
        "subjectName": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "classNumber", "day", "periodNumber"]
    },
    "Notice": {
      "title": "Notice",
      "description": "School circular, notice, or official announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 3000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "targetRole": { "type": "string", "enum": ["all", "admin", "teacher", "student"] },
        "category": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "targetRole", "isPublic", "status"]
    },
    "StudentDocument": {
      "title": "StudentDocument",
      "description": "Student certificates, transfer certificates, and verification records.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "documentType": { "type": "string", "maxLength": 100 },
        "verificationStatus": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "title"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and action audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "userRole": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "entity": { "type": "string", "maxLength": 100 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "action", "entity", "timestamp"]
    },
    "VerificationLog": {
      "title": "VerificationLog",
      "description": "Immutable institutional data verification audit record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entity": { "type": "string", "maxLength": 120 },
        "field": { "type": "string", "maxLength": 120 },
        "previousValue": { "type": "string", "maxLength": 500 },
        "newValue": { "type": "string", "maxLength": 500 },
        "source": { "type": "string", "maxLength": 200 },
        "verificationStatus": { "type": "string", "maxLength": 60 },
        "updatedBy": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "entity", "field", "updatedAt"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Public school institutional metadata and homepage configuration.",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 250 },
        "schoolCode": { "type": "string", "maxLength": 50 },
        "academicYear": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 40 }
      },
      "required": ["schoolName", "schoolCode"]
    },
    "FacilityItem": {
      "title": "FacilityItem",
      "description": "Campus infrastructure and facility item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameEn": { "type": "string", "maxLength": 150 },
        "nameHi": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "nameEn"]
    },
    "GovernmentScheme": {
      "title": "GovernmentScheme",
      "description": "Government welfare scheme such as DBT or Mid-Day Meal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "nameHi": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "nameEn"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Photo and educational video gallery record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleHi": { "type": "string", "maxLength": 200 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "titleEn"]
    },
    "PublicDocument": {
      "title": "PublicDocument",
      "description": "Publicly downloadable school circular or official PDF document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleHi": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "titleEn"]
    },
    "RegistrationRequest": {
      "title": "RegistrationRequest",
      "description": "Pending user registration request submitted for Head Teacher approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 50 },
        "requestedRole": { "type": "string", "enum": ["teacher", "student"] },
        "fullName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "preferredUsername": { "type": "string", "maxLength": 50 },
        "admissionNumber": { "type": "string", "maxLength": 50 },
        "classNumber": { "type": "number" },
        "sectionName": { "type": "string", "maxLength": 10 },
        "employeeId": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED"] },
        "createdAt": { "type": "string" },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string" },
        "rejectionReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "schoolId", "requestedRole", "fullName", "email", "preferredUsername", "status", "createdAt"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Authentication and security attempt logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 50 },
        "username": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "BLOCKED"] },
        "action": { "type": "string", "maxLength": 50 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "schoolId", "username", "status", "action", "timestamp"]
    },
    "EmailVerification": {
      "title": "EmailVerification",
      "description": "6-digit OTP code verification records for student email validation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "code": { "type": "string", "maxLength": 6 },
        "studentName": { "type": "string", "maxLength": 150 },
        "studentId": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "number" },
        "attempts": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "verified": { "type": "boolean" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["id", "email", "code", "createdAt", "expiresAt", "verified"]
    },
    "DonationRecord": {
      "title": "DonationRecord",
      "description": "College and school development donations, receipts, and payment records.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 50 },
        "donorName": { "type": "string", "maxLength": 150 },
        "donorEmail": { "type": "string", "maxLength": 150 },
        "donorPhone": { "type": "string", "maxLength": 25 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "reasonId": { "type": "string", "maxLength": 50 },
        "reasonLabelEn": { "type": "string", "maxLength": 150 },
        "reasonLabelHi": { "type": "string", "maxLength": 150 },
        "customReason": { "type": "string", "maxLength": 300 },
        "panNumber": { "type": "string", "maxLength": 20 },
        "donorAddress": { "type": "string", "maxLength": 300 },
        "isAnonymous": { "type": "boolean" },
        "paymentGateway": { "type": "string", "maxLength": 50 },
        "cashfreeOrderId": { "type": "string", "maxLength": 100 },
        "cashfreeCfOrderId": { "type": "string", "maxLength": 100 },
        "cashfreePaymentId": { "type": "string", "maxLength": 100 },
        "cashfreePaymentMethod": { "type": "string", "maxLength": 60 },
        "cashfreeBankReference": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["SUCCESS", "PENDING", "FAILED", "REFUNDED"] },
        "createdAt": { "type": "string" },
        "is80GClaimed": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "receiptNumber", "donorName", "amount", "status", "createdAt"]
    },
    "HealthProbe": {
      "title": "HealthProbe",
      "description": "Read-only Firestore startup connectivity probe document.",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": "HealthProbe",
      "description": "Public read-only connectivity check document (/test/connection)."
    },
    "/emailVerifications/{verificationId}": {
      "schema": "EmailVerification",
      "description": "Student email verification OTP codes with expiration and attempt limits."
    },
    "/donations/{donationId}": {
      "schema": "DonationRecord",
      "description": "College donation receipts and verified transactions with 80G tax certificate details."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records protected with UID matching and Admin ABAC controls."
    },
    "/registrationRequests/{requestId}": {
      "schema": "RegistrationRequest",
      "description": "Pending registrations reviewed and approved by Head Teacher."
    },
    "/securityLogs/{logId}": {
      "schema": "SecurityLog",
      "description": "Security and authentication attempt logs."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student master records protected against unauthorized viewing; accessible to matching student, admins, or assigned teachers."
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Faculty profile records."
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "School academic classes."
    },
    "/sections/{sectionId}": {
      "schema": "Section",
      "description": "Academic sections."
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects."
    },
    "/teacherAssignments/{assignmentId}": {
      "schema": "TeacherAssignment",
      "description": "Faculty class and subject allocations."
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Daily attendance records."
    },
    "/examinations/{examId}": {
      "schema": "Examination",
      "description": "Examination schedule definitions."
    },
    "/marks/{markId}": {
      "schema": "Mark",
      "description": "Student marks and exam performance records."
    },
    "/homework/{homeworkId}": {
      "schema": "Homework",
      "description": "Homework and learning assignments."
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Student homework submissions and grading notes."
    },
    "/timetable/{timetableId}": {
      "schema": "TimetableItem",
      "description": "Master class timetable periods."
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Notices and circulars for school community."
    },
    "/documents/{documentId}": {
      "schema": "StudentDocument",
      "description": "Student certificates and official documents."
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable audit trails of sensitive actions."
    },
    "/verificationLogs/{logId}": {
      "schema": "VerificationLog",
      "description": "Immutable institutional data verification logs."
    },
    "/settings/{settingId}": {
      "schema": "SchoolSettings",
      "description": "School institutional metadata and public homepage settings."
    },
    "/facilities/{facilityId}": {
      "schema": "FacilityItem",
      "description": "Campus facilities and infrastructure."
    },
    "/governmentSchemes/{schemeId}": {
      "schema": "GovernmentScheme",
      "description": "Government welfare schemes (DBT, MDM, scholarships)."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "School photo and educational video gallery."
    },
    "/publicDocuments/{docId}": {
      "schema": "PublicDocument",
      "description": "Publicly accessible government circulars and PDFs."
    }
  }
}
